{
  "name": "portfolio",
  "version": "3.0.0",
  "description": "Portfolio of Jorge Arcas, freelance full-stack developer. Vite + React, statically prerendered.",
  "author": "Jorge Arcas <jorgearcasverdejo@gmail.com> (https://github.com/J0rgw)",
  "license": "MIT",
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "vite",
    "ssg",
    "gsap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J0rgw/Portfoliov3.git"
  },
  "bugs": {
    "url": "https://github.com/J0rgw/Portfoliov3/issues"
  },
  "homepage": "https://portfolio.jarcas.dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:architecture && npm run test:config && npm run check:assets && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && npm run check:seo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "og": "node scripts/generate-og.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:config": "tsx scripts/test-config.ts"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reicon-react": "^1.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "baseline-browser-mapping": "^2.9.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
